flowchart LR

%% =========================
%% LAYERS
%% =========================
subgraph UI["Presentation (features/*/screens & components)"]
  UI_S1["features/auth/screens/LoginScreen"]
  UI_S2["features/ticket/screens/SeatMapScreen"]
  UI_S3["features/payment/screens/CheckoutScreen"]
end

subgraph Hooks["Feature Hooks (features/*/hooks)"]
  H1["useLogin (mutation)"]
  H2["useSeatMap (query + local selection)"]
  H3["useCreateOrder (mutation)"]
end

subgraph Impl["Infrastructure in Features (features/*/services)"]
  R1["authRepositoryImpl"]
  R2["ticketRepositoryImpl"]
  R3["paymentRepositoryImpl"]
  API1["authApi"]
  API2["ticketApi"]
  API3["paymentApi"]
end

subgraph Domain["Domain (domains/*)"]
  E1["entities: User / Seat / Ticket / Order"]
  UC1["useCases: login / reserveSeat / createOrder"]
  I1["repository interfaces: IAuthRepository / ITicketRepository / IPaymentRepository"]
end

subgraph Core["Core (core/*) - tech common"]
  C1["httpClient (axios)"]
  C2["interceptors (token attach / error parse)"]
  C3["storage (secureStore/AsyncStorage wrapper)"]
  C4["navigation (RootNavigator/routes)"]
  C5["theme/utils/types/config"]
end

subgraph State["State"]
  S1["Zustand: authStore (session)"]
  S2["Zustand: uiStore (toast/modal)"]
  Q1["React Query: QueryClient cache"]
end

subgraph App["App Composition (app/*, App.tsx)"]
  P1["AppProviders (QueryProvider etc.)"]
  A1["App.tsx"]
end

%% =========================
%% DEPENDENCIES
%% =========================

%% App bootstraps providers and navigation
A1 --> P1
P1 --> Q1
A1 --> C4

%% UI calls feature hooks
UI_S1 --> H1
UI_S2 --> H2
UI_S3 --> H3

%% Hooks use domain useCases (business rules)
H1 --> UC1
H2 --> UC1
H3 --> UC1

%% Hooks use React Query cache + Zustand (runtime/app state)
H1 --> Q1
H2 --> Q1
H3 --> Q1

H1 --> S1
H2 --> S2
H3 --> S1

%% UseCases depend on repository interfaces + entities
UC1 --> I1
UC1 --> E1

%% Feature repository implementations implement domain interfaces
R1 --> I1
R2 --> I1
R3 --> I1

%% Repos call feature API wrappers
R1 --> API1
R2 --> API2
R3 --> API3

%% API wrappers use core http client
API1 --> C1
API2 --> C1
API3 --> C1

%% Core http client uses interceptors and storage (token fetch) - but core does not know domains
C1 --> C2
C2 --> C3

%% Core utilities can be used anywhere (optional edges shown lightly)
UI_S1 -.-> C5
H1 -.-> C5
UC1 -.-> C5

%% =========================
%% RULE NOTES
%% =========================
%% Features -> Domain -> Core
%% Domain never imports React/React Native, Zustand, React Query.
%% Core never imports Domain or Features.
